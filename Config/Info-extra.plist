<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSAppleEventsUsageDescription</key>
	<string>Scroblytics uses Music to see which songs and albums are in your library, to build playlists you ask for, and, only when you confirm, to remove entries from your Favorite Songs.</string>
	<key>GetSongBPMAPIKey</key>
	<string>$(GETSONGBPM_API_KEY)</string>
	<key>LastfmAPIKey</key>
	<string>$(LASTFM_API_KEY)</string>
	<key>LastfmAPISecret</key>
	<string>$(LASTFM_API_SECRET)</string>
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.scroblytics.native-backup</string>
			<key>UTTypeDescription</key>
			<string>Scroblytics Backup</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>scroblyticsbackup</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
