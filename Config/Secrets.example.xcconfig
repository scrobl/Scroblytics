// Copy to Secrets.xcconfig (git-ignored) and fill in. Baked into the built app's Info.plist at build time.
GETSONGBPM_API_KEY = your-getsongbpm-key
// The Last.fm API key and shared secret built into the app (32 hex digits each; the key's owner needs Last.fm Pro). They are readable by
// anyone who opens the shipped app. Never commit the real values.
LASTFM_API_KEY = your-lastfm-api-key
LASTFM_API_SECRET = your-lastfm-shared-secret
